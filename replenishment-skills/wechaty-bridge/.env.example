# Wechaty
WECHATY_PUPPET=wechaty-puppet-wechat4u
WECHATY_PUPPET_WECHAT4U_TOKEN=

# OpenClaw Gateway · REST inbound
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_INBOUND_PATH=/rest/inbound
OPENCLAW_INBOUND_API_KEY=replace-inbound-api-key
OPENCLAW_ACCOUNT_ID=default

# Bridge outbound webhook (configure same URL in openclaw-rest-channel)
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8787
WEBHOOK_PATH=/openclaw/outbound
OPENCLAW_WEBHOOK_SECRET=replace-webhook-secret

# Supplier registry (群名白名单)
# 开发可用 example；生产请改为 config/suppliers-registry.yaml
SUPPLIERS_REGISTRY_PATH=../skills/wechat-supplier-collab/references/suppliers-registry.example.yaml
# SUPPLIERS_REGISTRY_PATH=./config/suppliers-registry.yaml

# 采控微信号（私聊指挥 / 确认发送），逗号分隔
PROCUREMENT_CONTACT_IDS=

# 日志
LOG_LEVEL=info
