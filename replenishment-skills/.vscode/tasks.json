{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "供应商协同：一键启用（推荐）",
      "type": "shell",
      "command": "npm run wechat:enable",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "供应商协同：交互初始化",
      "type": "shell",
      "command": "npm run setup:wechat-supplier",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "供应商协同：启动 wechaty-bridge",
      "type": "shell",
      "command": "npm run wechat:bridge",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "供应商协同：检查配置",
      "type": "shell",
      "command": "npm run wechat:verify",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "OpenClaw：查看技能列表",
      "type": "shell",
      "command": "openclaw skills list",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "OpenClaw：跟踪日志",
      "type": "shell",
      "command": "openclaw logs --follow",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
