# Anthropic API（Claude Agent SDK）
ANTHROPIC_API_KEY=sk-ant-your-key-here

# 可选：兼容 Anthropic 协议的代理地址
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# 可选：Claude 模型（Agent SDK 内部使用 sonnet 时可忽略此项）
# CLAUDE_MODEL=sonnet

# 访问控制：首次私聊会回复配对码，在终端执行 pair <code> 后才会处理消息
# 设为 false 则跳过配对（仅建议在完全可信环境使用）
REQUIRE_PAIRING=true
