# Anthropic API（Claude Agent SDK）
ANTHROPIC_API_KEY=sk-ant-your-key-here

# 可选：兼容 Anthropic 协议的代理地址
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# 可选：Claude 模型
# CLAUDE_MODEL=sonnet

# ─── 安全与访问控制 ─────────────────────────────────────────

# 项目沙箱根目录（Claude 默认只能在此目录内自动操作）
PROJECT_ROOT=/path/to/your/project

# 允许使用 Bot 的微信用户 ID（逗号分隔，强烈建议配置）
# 示例: o9cq800kum_xxx@im.wechat 或只写前缀 o9cq800kum
ALLOWED_WECHAT_IDS=your_wechat_id@im.wechat

# 管理员微信 ID：接收「越权操作」确认通知，并可执行管理指令
ADMIN_WECHAT_IDS=your_wechat_id@im.wechat

# 微信指令前缀（默认 /）
COMMAND_PREFIX=/

# 越权审批超时（毫秒），默认 5 分钟
# APPROVAL_TIMEOUT_MS=300000

# 首次私聊需配对（管理员可用 /配对 <码> 或终端 pair）
REQUIRE_PAIRING=true

# 是否允许 WebFetch/WebSearch（默认 false；开启后仍可能触发审批）
ALLOW_NETWORK=false

# 每用户每分钟最大消息数
RATE_LIMIT_PER_MINUTE=12
